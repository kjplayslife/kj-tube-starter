// Copy this file to Secrets.xcconfig (gitignored) and fill it in. Never commit the real file.

// Required: a YouTube Data API v3 key from your own Google Cloud project.
// Restrict it to the YouTube Data API and to your app's bundle ID.
YOUTUBE_API_KEY = your-youtube-data-api-key

// Optional: a Google "iOS" OAuth client ID for "Import from YouTube" (reads the list of
// channels you subscribe to). Looks like 123456-abc.apps.googleusercontent.com.
// Without it the import buttons are hidden.
GOOGLE_CLIENT_ID =

// Your Apple Developer team ID (10 characters), needed only to run on a real iPhone.
DEVELOPMENT_TEAM =
